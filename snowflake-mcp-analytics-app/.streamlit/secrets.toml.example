# Only needed if you run streamlit_app.py OUTSIDE Snowflake.
# Inside Streamlit in Snowflake, st.connection("snowflake") uses the built-in session
# and no credentials are required.
#
# Copy this file to .streamlit/secrets.toml (which is git-ignored) and fill in your own values.

[connections.snowflake]
account   = "<your_account_identifier>"
user      = "<your_user>"
authenticator = "externalbrowser"   # or key-pair auth; avoid plain passwords
role      = "<read_only_app_role>"
warehouse = "CLASS_WH"
database  = "SAKILA"
schema    = "DW"
